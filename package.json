{
  "name": "cgraph-web",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "CGraph browser client workspace",
  "scripts": {
    "dev": "pnpm --filter @cgraph/web dev",
    "dev:production-backend": "pnpm env:local:production && VITE_DEV_DISABLE_TURNSTILE=true pnpm dev",
    "dev:production-backend:captcha": "pnpm env:local:production && VITE_DEV_DISABLE_TURNSTILE=false pnpm dev",
    "dev:production-backend:no-captcha": "pnpm env:local:production && VITE_DEV_DISABLE_TURNSTILE=true pnpm dev",
    "env:local:production": "node scripts/sync-vercel-public-env.mjs",
    "build": "pnpm --filter @cgraph/web build",
    "check:packages": "node scripts/validate-package-dependencies.mjs",
    "check:package-owner": "node scripts/validate-package-dependencies.mjs",
    "check:web-release": "pnpm --filter @cgraph/web check:release-gates",
    "lint": "pnpm --filter @cgraph/web lint",
    "pixellab:assets": "node scripts/pixellab-generate-cgraph-assets.mjs",
    "test": "pnpm --filter @cgraph/web test:run",
    "typecheck": "pnpm --filter @cgraph/web typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint-plugin-react": "^7.37.0"
  },
  "engines": {
    "node": ">=20.x",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "@types/react": "19.1.17",
      "glob": "^11.0.0",
      "rimraf": "^6.0.0",
      "inflight": "npm:@pnpm/noop@1.0.0",
      "tar": ">=7.5.10",
      "esbuild": "0.25.12",
      "@babel/runtime": ">=7.26.10",
      "tmp": ">=0.2.4",
      "@tootallnate/once": ">=3.0.1",
      "axios": "1.16.1",
      "protobufjs": "7.5.8",
      "vite": "6.4.2"
    },
    "onlyBuiltDependencies": [
      "@next/swc",
      "@parcel/watcher",
      "@sentry/cli",
      "@swc/core",
      "bufferutil",
      "core-js",
      "esbuild",
      "msw",
      "msgpack",
      "protobufjs",
      "utf-8-validate"
    ],
    "allowedDeprecatedVersions": {
      "glob": "*",
      "whatwg-encoding": "3.1.1"
    }
  }
}
