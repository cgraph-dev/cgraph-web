{
  "name": "@cgraph/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:bundle-budgets": "node ./scripts/check-bundle-budgets.mjs",
    "check:background-polling": "node ./scripts/check-background-polling.mjs",
    "check:import-cycles": "node ./scripts/check-import-cycles.mjs",
    "check:customization-lottie-assets": "node ./scripts/check-customization-lottie-assets.mjs",
    "check:state-stores": "node ./scripts/check-state-stores.mjs",
    "check:safe-html": "node ./scripts/check-safe-html-sinks.mjs",
    "check:storage-policy": "node ./scripts/check-storage-policy.mjs",
    "check:auth-storage": "vitest run --coverage=false src/lib/__tests__/safeStorage.test.ts src/modules/auth/store/__tests__/auth-actions.test.ts src/modules/auth/store/__tests__/authStore.test.ts src/modules/auth/store/__tests__/authStore.utils.test.ts",
    "check:unit-suite": "vitest run --coverage=false --reporter=dot --maxWorkers=1 --minWorkers=1",
    "check:release-gates": "pnpm check:customization-lottie-assets && pnpm check:safe-html && pnpm check:storage-policy && pnpm check:import-cycles && pnpm check:state-stores && pnpm check:background-polling && pnpm check:auth-storage && pnpm check:unit-suite",
    "build:budget": "pnpm build && pnpm check:bundle-budgets",
    "build:strict": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "lint": "eslint src/ --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "VITE_E2E_AUTH_BYPASS=true pnpm build && VITE_E2E_AUTH_BYPASS=true PLAYWRIGHT_HTML_OPEN=never PLAYWRIGHT_REUSE_EXISTING_SERVER=false PLAYWRIGHT_WEB_SERVER_COMMAND=\"pnpm exec vite preview --host 127.0.0.1 --port 3000 --strictPort\" playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "smoke:production": "node ./scripts/smoke-production.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lighthouse": "pnpm build && lhci autorun --config=.lighthouserc.json"
  },
  "dependencies": {
    "@cgraph-dev/animation-constants": "1.3.1",
