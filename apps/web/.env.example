# Public browser configuration. Every VITE_* value is embedded in the built app.
# Keep secrets on the backend or in Fly/Vercel server-side environments.

# Release identity
VITE_APP_VERSION=0.9.31

# Backend routing
# Production normally uses same-origin Vercel rewrites, so leave these blank
# unless a deployment must call the backend directly.
VITE_API_URL=
VITE_WS_URL=
VITE_SOCKET_URL=

# Auth abuse protection
VITE_TURNSTILE_SITE_KEY=

# Observability
VITE_SENTRY_DSN=
VITE_OTEL_TRACE_ENDPOINT=
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_SENTRY=true
VITE_ENABLE_LOGGING=false

# Push notifications
VITE_VAPID_PUBLIC_KEY=

# Calls
VITE_LIVEKIT_URL=
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Wallet integrations
VITE_WC_PROJECT_ID=
VITE_WALLETCONNECT_PROJECT_ID=

# Storage policy
# Off by default because broad query persistence writes API data to browser storage.
VITE_ENABLE_QUERY_CACHE_PERSISTENCE=false
