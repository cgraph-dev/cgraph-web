# =============================================================================
# CGraph Web Frontend Environment Configuration - Production
# =============================================================================

# API Configuration - Production Backend
# Production deploys can leave these blank and use Vercel rewrites.
# Local dev should leave these blank too, so Vite proxies /api and /socket
# to cgraph-backend-prod-v2.fly.dev.
VITE_API_URL=
VITE_WS_URL=
VITE_SOCKET_URL=
VITE_DEV_API_TARGET=https://cgraph-backend-prod-v2.fly.dev
VITE_DEV_WS_TARGET=wss://cgraph-backend-prod-v2.fly.dev

# App Configuration
VITE_APP_NAME=CGraph
VITE_APP_VERSION=0.9.2

# Cloudflare Turnstile CAPTCHA
# Must match the widget configured for the frontend domain.
VITE_TURNSTILE_SITE_KEY=
# Local frontend development only. Keep false in Vercel/production.
VITE_DEV_DISABLE_TURNSTILE=false
# Local dev proxy secret. Server-side Vite config reads this; never prefix with VITE_.
CGRAPH_DEV_TURNSTILE_BYPASS_TOKEN=

# AI Configuration - Disabled (placeholder for future)
VITE_AI_ENABLED=false
